<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="AppSplash" parent="Theme.SplashScreen">
    <item name="windowSplashScreenBackground">@android:color/system_neutral1_100</item>
    <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_splash</item>
    <item name="windowSplashScreenIconBackgroundColor">@color/colorPrimaryVariant</item>
    <item name="windowSplashScreenAnimationDuration">1000</item>
    <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    <item name="android:statusBarColor">@android:color/system_neutral1_100</item>
    <item name="android:navigationBarColor">@android:color/system_neutral1_100</item>
    <item name="android:windowLightStatusBar">true</item>
  </style>

  <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryVariantTransparent</item>
    <item name="colorAccent">@android:color/system_accent1_500</item>
    <item name="android:fontFamily">@font/app_font</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:navigationBarColor">@color/colorPrimaryVariantTransparent</item>
    <item name="android:progressTint">@android:color/system_accent1_500</item>
    <item name="thumbTint">@android:color/system_accent1_500</item>
    <item name="trackTint">@android:color/system_accent1_100</item>
  </style>

  <style name="AppTheme.PopupOverlay" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
    <item name="actionBarItemBackground">@android:color/system_neutral1_100</item>
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="popupMenuBackground">@drawable/bg_dialog</item>
  </style>
</resources>
