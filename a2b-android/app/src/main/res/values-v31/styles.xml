<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryVariantTransparent</item>
    <item name="colorAccent">@android:color/system_accent1_500</item>
    <item name="android:fontFamily">@font/app_font</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:navigationBarColor">@color/colorPrimaryVariantTransparent</item>
    <item name="android:progressTint">@android:color/system_accent1_500</item>
    <item name="thumbTint">@android:color/system_accent1_500</item>
    <item name="trackTint">@android:color/system_accent1_100</item>
  </style>

  <style name="ButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@android:color/system_accent1_500</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:background">?selectableItemBackground</item>
    <item name="rippleColor">@color/colorOnPrimaryLightest</item>
  </style>

  <style name="FeedbackInputStyle" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorControlNormal">@android:color/system_accent1_500</item>
    <item name="colorControlActivated">@android:color/system_accent1_300</item>
    <item name="colorControlHighlight">@android:color/system_accent1_300</item>
    <item name="android:textColorHighlight">@android:color/system_accent1_300</item>
  </style>

  <style name="SearchButtonStyle" parent="@style/Widget.MaterialComponents.Button.Icon">
    <item name="android:layout_marginTop">@dimen/fab_margin</item>
    <item name="android:layout_marginBottom">@dimen/fab_margin</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="backgroundTint">@color/colorSecondary</item>
    <item name="cornerRadius">@dimen/card_radius</item>
    <item name="iconTint">@android:color/system_accent1_500</item>
    <item name="iconTintMode">src_in</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="DialogPrimaryButtonStyle" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorOnPrimaryUntranslated</item>
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="backgroundTint">@android:color/system_accent1_500</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="DialogSecondaryButtonStyle" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="backgroundTint">@android:color/transparent</item>
    <item name="rippleColor">@android:color/system_accent1_500</item>
  </style>

  <style name="FabStyle" parent="Widget.MaterialComponents.Button.Icon">
    <item name="backgroundTint">@android:color/system_accent1_300</item>
    <item name="iconTint">@android:color/system_accent1_100</item>
    <item name="iconGravity">textStart|end</item>
    <item name="textAllCaps">false</item>
    <item name="cornerRadius">@dimen/card_radius</item>
  </style>

  <style name="SelectorButtonStyle" parent="Widget.MaterialComponents.Button.OutlinedButton">
    <item name="strokeColor">@android:color/system_accent1_500</item>
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="android:textColor">@color/color_state_selector_text</item>
    <item name="backgroundTint">@color/color_state_selector_bg</item>
  </style>

  <style name="TrackerBackgroundStyle">
    <item name="android:background">@android:color/system_accent1_500</item>
  </style>
</resources>
