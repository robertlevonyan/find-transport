<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!--  button-->
  <style name="Button.Regular" parent="Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@android:color/system_accent1_500</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:background">?selectableItemBackground</item>
    <item name="rippleColor">@color/colorOnPrimaryLightest</item>
  </style>

  <style name="Button.Search" parent="@style/Widget.MaterialComponents.Button.Icon">
    <item name="android:layout_marginTop">@dimen/fab_margin</item>
    <item name="android:layout_marginBottom">@dimen/fab_margin</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">@dimen/text_size_16</item>
    <item name="android:textColor">@android:color/system_neutral2_900</item>
    <item name="backgroundTint">@android:color/system_neutral2_100</item>
    <item name="cornerRadius">@dimen/card_radius</item>
    <item name="iconTint">@android:color/system_accent1_500</item>
    <item name="iconTintMode">src_in</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="Button.Positive" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorOnPrimaryUntranslated</item>
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="backgroundTint">@android:color/system_accent1_500</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="Button.Negative" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="backgroundTint">@android:color/transparent</item>
    <item name="rippleColor">@android:color/system_accent1_500</item>
  </style>

  <style name="Button.Selector" parent="Widget.MaterialComponents.Button.OutlinedButton">
    <item name="strokeColor">@android:color/system_accent1_500</item>
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="android:textColor">@color/color_state_selector_text</item>
    <item name="backgroundTint">@color/color_state_selector_bg</item>
  </style>

  <style name="FloatingActionButton.Regular" parent="Widget.MaterialComponents.Button.Icon">
    <item name="backgroundTint">@android:color/system_accent1_300</item>
    <item name="iconTint">@android:color/system_accent1_100</item>
    <item name="iconGravity">textStart|end</item>
    <item name="textAllCaps">false</item>
    <item name="cornerRadius">@dimen/card_radius</item>
  </style>

  <style name="FloatingActionButton.Small" parent="Widget.MaterialComponents.FloatingActionButton">
    <item name="backgroundTint">@android:color/system_neutral2_100</item>
    <item name="elevation">3dp</item>
    <item name="fabSize">mini</item>
    <item name="tint">@android:color/system_neutral2_900</item>
  </style>
  <!--  button-->

  <!--  text-->
  <style name="Input.Feedback" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorControlNormal">@android:color/system_accent1_500</item>
    <item name="colorControlActivated">@android:color/system_accent1_300</item>
    <item name="colorControlHighlight">@android:color/system_accent1_300</item>
    <item name="android:textColorHighlight">@android:color/system_accent1_300</item>
  </style>
  <!--  text-->

  <!--  card view-->
  <style name="CardView.Regular" parent="Widget.MaterialComponents.CardView">
    <item name="cardCornerRadius">@dimen/card_radius</item>
    <item name="cardElevation">0dp</item>
    <item name="cardBackgroundColor">@android:color/system_neutral1_200</item>
  </style>

  <!--  card view-->

  <!--  backgrounds-->
  <style name="Background">
    <item name="android:background">@android:color/system_neutral1_100</item>
  </style>

  <style name="TrackerBackground">
    <item name="android:background">@android:color/system_accent1_500</item>
  </style>
  <!--  backgrounds-->

  <!--  loading-->
  <style name="Loading">
    <item name="android:indeterminateTint">@android:color/system_accent1_500</item>
  </style>
  <!--  loading-->
</resources>
