<?xml version="1.0" encoding="utf-8"?>
<resources>

  <style name="Button.Search" parent="@style/Widget.MaterialComponents.Button.Icon">
    <item name="android:layout_marginTop">@dimen/fab_margin</item>
    <item name="android:layout_marginBottom">@dimen/fab_margin</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">@dimen/text_size_16</item>
    <item name="android:textColor">@android:color/system_neutral2_100</item>
    <item name="backgroundTint">@android:color/system_neutral2_800</item>
    <item name="cornerRadius">@dimen/card_radius</item>
    <item name="iconTint">@android:color/system_accent1_500</item>
    <item name="iconTintMode">src_in</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="FloatingActionButton.Small" parent="Widget.MaterialComponents.FloatingActionButton">
    <item name="backgroundTint">@android:color/system_neutral2_800</item>
    <item name="elevation">3dp</item>
    <item name="fabSize">mini</item>
    <item name="tint">@android:color/system_neutral2_100</item>
  </style>

  <style name="BottomSheetTheme.Dark.Dialog" parent="BaseBottomSheet.Dark.Dialog">
    <item name="android:statusBarColor">@android:color/transparent</item>
  </style>

  <style name="Background">
    <item name="android:background">@android:color/system_neutral1_900</item>
  </style>

  <style name="CardView.Regular" parent="Widget.MaterialComponents.CardView">
    <item name="cardCornerRadius">@dimen/card_radius</item>
    <item name="cardElevation">0dp</item>
    <item name="cardBackgroundColor">@android:color/system_neutral1_800</item>
    <item name="tint">@color/colorOnPrimary</item>
  </style>

  <style name="CardView.Section" parent="Widget.MaterialComponents.CardView">
    <item name="cardCornerRadius">@dimen/card_radius</item>
    <item name="cardElevation">0dp</item>
    <item name="cardBackgroundColor">@android:color/system_neutral2_800</item>
  </style>
</resources>
