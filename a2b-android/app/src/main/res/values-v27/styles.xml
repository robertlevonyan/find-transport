<?xml version="1.0" encoding="utf-8"?>
<resources>
  
  <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryDarkTransparent</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:fontFamily">@font/app_font</item>
    <item name="android:windowLightStatusBar">true</item>
    <item name="android:windowLightNavigationBar">true</item>
    <item name="android:navigationBarColor">@color/colorPrimaryDarkTransparent</item>
  </style>

  <style name="BottomSheetDialogThemeDark" parent="BaseBottomSheetDialogDark">
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@color/colorPrimaryDark23</item>
    <item name="android:windowLightNavigationBar">true</item>
  </style>
</resources>
