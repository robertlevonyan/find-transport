<resources xmlns:tools="http://schemas.android.com/tools">

  <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorPrimary">@color/colorPrimary</item>
    <item name="colorPrimaryDark">@color/colorPrimaryVariantTransparent</item>
    <item name="colorAccent">@color/colorAccent</item>
    <item name="android:fontFamily">@font/app_font</item>
  </style>

  <style name="AppTheme.NoActionBar">
    <item name="windowActionBar">false</item>
    <item name="windowNoTitle">true</item>
    <item name="android:windowIsTranslucent">true</item>
  </style>

  <style name="AppTheme.AppBarOverlay" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
    <item name="colorControlNormal">@color/colorOnPrimary</item>
    <item name="android:textColorSecondary">@color/colorOnPrimary</item>
  </style>

  <style name="AppTheme.PopupOverlay" parent="@style/Widget.MaterialComponents.PopupMenu.Overflow">
    <item name="actionBarItemBackground">@color/colorPrimaryVariant23</item>
    <item name="android:textColor">@color/colorOnPrimary</item>
  </style>

  <style name="ToolbarTitleText" parent="Base.TextAppearance.AppCompat.Title">
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="android:textSize">@dimen/text_size_18</item>
    <item name="android:textStyle">bold</item>
    <item name="android:fontFamily">@font/app_font</item>
  </style>

  <style name="ButtonStyle" parent="Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorAccent</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:background">?selectableItemBackground</item>
    <item name="rippleColor">@color/colorOnPrimaryLightest</item>
  </style>

  <style name="BottomSheetDark" parent="@style/Widget.Design.BottomSheet.Modal">
    <item name="android:background">@drawable/bg_bottom_sheet_dark</item>
    <item name="android:layout_marginHorizontal" tools:targetApi="o">@dimen/margin_tablet</item>
  </style>

  <style name="BaseBottomSheetDialogDark" parent="@style/Theme.Design.Light.BottomSheetDialog">
    <item name="android:windowIsFloating">false</item>
    <item name="bottomSheetStyle">@style/BottomSheetDark</item>
  </style>

  <style name="BottomSheetDialogThemeDark" parent="BaseBottomSheetDialogDark">
    <item name="android:statusBarColor">@android:color/transparent</item>
  </style>

  <style name="InputTextStyle" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="android:textColorHint">@color/colorOnPrimary</item>
    <item name="colorControlActivated">@color/colorOnPrimary</item>
    <item name="colorControlHighlight">@color/colorOnPrimary</item>
  </style>

  <style name="EditTextStyle" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="android:textColorHint">@color/colorOnPrimary</item>
    <item name="colorControlActivated">@color/colorOnPrimaryLighter</item>
    <item name="colorControlHighlight">@color/colorOnPrimaryLighter</item>
    <item name="colorControlNormal">@color/colorOnPrimaryLighter</item>
  </style>

  <style name="FeedbackInputStyle" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorControlNormal">@color/colorAccent</item>
    <item name="colorControlActivated">@color/colorAccent</item>
    <item name="colorControlHighlight">@color/colorAccent</item>
    <item name="android:textColorHighlight">@color/colorAccent</item>
  </style>
</resources>
