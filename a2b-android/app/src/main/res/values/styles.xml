<resources xmlns:tools="http://schemas.android.com/tools">
  <!--  text-->
  <style name="Text.Toolbar" parent="Base.TextAppearance.AppCompat.Title">
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="android:textSize">@dimen/text_size_18</item>
    <item name="android:textStyle">bold</item>
    <item name="android:fontFamily">@font/app_font</item>
  </style>

  <style name="Input.Regular" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="android:textColorHint">@color/colorOnPrimary</item>
    <item name="colorControlActivated">@color/colorOnPrimary</item>
    <item name="colorControlHighlight">@color/colorOnPrimary</item>
  </style>

  <style name="Input.Feedback" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="colorControlNormal">@color/colorAccent500</item>
    <item name="colorControlActivated">@color/colorAccent300</item>
    <item name="colorControlHighlight">@color/colorAccent500</item>
    <item name="android:textColorHighlight">@color/colorAccent500</item>
  </style>

  <style name="EditText.Regular" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
    <item name="android:textColorHint">@color/colorOnPrimary</item>
    <item name="colorControlActivated">@color/colorOnPrimaryLighter</item>
    <item name="colorControlHighlight">@color/colorOnPrimaryLighter</item>
    <item name="colorControlNormal">@color/colorOnPrimaryLighter</item>
  </style>
  <!--  text-->

  <!--button-->
  <style name="Button.Transports" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:layout_marginTop">@dimen/fab_margin</item>
    <item name="android:layout_marginBottom">@dimen/fab_margin</item>
    <item name="android:paddingStart">@dimen/fab_margin</item>
    <item name="android:paddingEnd">@dimen/fab_margin</item>
    <item name="android:paddingTop">@dimen/half_margin</item>
    <item name="android:paddingBottom">@dimen/half_margin</item>
    <item name="android:textSize">@dimen/text_size_14</item>
    <item name="textAllCaps">false</item>
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="backgroundTint">@android:color/transparent</item>
    <item name="cornerRadius">?actionBarSize</item>
    <item name="iconTint">@color/colorOnPrimary</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="Button.Search" parent="@style/Widget.MaterialComponents.Button.Icon">
    <item name="android:layout_marginTop">@dimen/fab_margin</item>
    <item name="android:layout_marginBottom">@dimen/fab_margin</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:textSize">@dimen/text_size_16</item>
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="backgroundTint">@color/colorSecondary</item>
    <item name="cornerRadius">@dimen/card_radius</item>
    <item name="iconTint">@color/colorAccent500</item>
    <item name="iconTintMode">src_in</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="Button.Positive" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorOnPrimaryUntranslated</item>
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="backgroundTint">@color/colorAccent500</item>
    <item name="rippleColor">@color/colorSecondary</item>
  </style>

  <style name="Button.Negative" parent="@style/Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorOnPrimary</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="backgroundTint">@android:color/transparent</item>
    <item name="rippleColor">@color/colorAccent500</item>
  </style>

  <style name="Button.Regular" parent="Widget.MaterialComponents.Button.UnelevatedButton">
    <item name="android:textColor">@color/colorAccent500</item>
    <item name="textAllCaps">false</item>
    <item name="android:textStyle">bold</item>
    <item name="android:background">?selectableItemBackground</item>
    <item name="rippleColor">@color/colorOnPrimaryLightest</item>
  </style>

  <style name="Button.Selector" parent="Widget.MaterialComponents.Button.OutlinedButton">
    <item name="strokeColor">@color/colorAccent500</item>
    <item name="android:textStyle">bold</item>
    <item name="textAllCaps">false</item>
    <item name="android:textColor">@color/color_state_selector_text</item>
    <item name="backgroundTint">@color/color_state_selector_bg</item>
  </style>

  <style name="FloatingActionButton.Regular" parent="Widget.MaterialComponents.Button.Icon">
    <item name="backgroundTint">@color/colorAccent300</item>
    <item name="iconTint">@color/colorAccent100</item>
    <item name="iconGravity">textStart|end</item>
    <item name="iconTintMode">src_in</item>
    <item name="cornerRadius">@dimen/card_radius</item>
  </style>

  <style name="FloatingActionButton.Small" parent="Widget.MaterialComponents.FloatingActionButton">
    <item name="backgroundTint">@color/colorSecondary</item>
    <item name="elevation">3dp</item>
    <item name="fabSize">mini</item>
    <item name="tint">@color/colorOnPrimary</item>
  </style>
  <!--button-->

  <!--  card view-->
  <style name="CardView.Regular" parent="Widget.MaterialComponents.CardView">
    <item name="cardCornerRadius">@dimen/card_radius</item>
    <item name="cardElevation">0dp</item>
    <item name="cardBackgroundColor">@color/colorSecondary</item>
  </style>

  <!--  card view-->

  <!--  bottom sheet-->
  <style name="BottomSheet.Dark" parent="@style/Widget.Design.BottomSheet.Modal">
    <item name="android:background">@drawable/bg_bottom_sheet_dark</item>
    <item name="android:layout_marginHorizontal" tools:targetApi="o">@dimen/margin_tablet</item>
  </style>

  <style name="BaseBottomSheet.Dark.Dialog" parent="@style/Theme.Design.Light.BottomSheetDialog">
    <item name="android:windowIsFloating">false</item>
    <item name="bottomSheetStyle">@style/BottomSheet.Dark</item>
  </style>

  <style name="BottomSheetTheme.Dark.Dialog" parent="BaseBottomSheet.Dark.Dialog">
    <item name="android:statusBarColor">@android:color/transparent</item>
  </style>
  <!--  bottom sheet-->

  <!--  backgrounds-->
  <style name="TrackerBackground">
    <item name="android:background">@color/colorAccent500</item>
  </style>

  <style name="Background">
    <item name="android:background">@color/colorPrimary</item>
  </style>
  <!--  backgrounds-->

  <!--  loading-->
  <style name="Loading" parent="Widget.MaterialComponents.CircularProgressIndicator">
    <item name="android:indeterminateTint">@color/colorAccent500</item>
  </style>
  <!--  loading-->
</resources>
