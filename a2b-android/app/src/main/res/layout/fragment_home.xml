<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".presentation.home.HomeFragment">

  <androidx.core.widget.NestedScrollView
    android:id="@+id/nsv_search_area"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    app:layout_behavior="com.google.android.material.appbar.AppBarLayout$ScrollingViewBehavior">

    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/cl_search_area"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:animateLayoutChanges="true">

      <TextView
        android:id="@+id/tv_from_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/fab_margin"
        android:text="@string/label_from_long"
        android:textColor="@color/colorOnPrimary"
        android:textSize="@dimen/text_size_20"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/cv_from_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9" />

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_from_input"
        style="@style/CardView.Regular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@+id/tv_from_error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/cl_from_input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:animateLayoutChanges="true"
          android:background="?selectableItemBackground"
          app:rippleColor="@color/colorOnPrimaryLight">

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/il_from"
            style="@style/Widget.Design.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_7"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginEnd="@dimen/margin_7"
            android:layout_marginBottom="@dimen/margin_7"
            android:hint="@string/hint_from"
            android:theme="@style/Input.Regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_from_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_from"
              android:layout_width="match_parent"
              android:layout_height="@dimen/search_input_height"
              android:background="@null"
              android:ellipsize="none"
              android:focusableInTouchMode="false"
              android:gravity="center_vertical|start"
              android:imeOptions="actionNext"
              android:inputType="text"
              android:paddingTop="@dimen/margin_x_small"
              android:scrollHorizontally="true"
              android:textColor="@color/colorOnPrimary"
              android:textColorHint="@color/colorHint"
              android:textCursorDrawable="@drawable/bg_cursor"
              android:textSize="@dimen/input_text_size"
              android:theme="@style/EditText.Regular" />
          </com.google.android.material.textfield.TextInputLayout>

          <ImageButton
            android:id="@+id/btn_from_map"
            android:layout_width="@dimen/icon_size2"
            android:layout_height="@dimen/icon_size2"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_small"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription" />

          <ImageButton
            android:id="@+id/btn_from_list"
            android:layout_width="@dimen/icon_size2"
            android:layout_height="@dimen/icon_size2"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_from_map"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_drop_down"
            tools:ignore="ContentDescription" />

          <ImageButton
            android:id="@+id/btn_from_clear"
            android:layout_width="@dimen/icon_size2"
            android:layout_height="@dimen/icon_size2"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_from_list"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_black_24dp"
            tools:ignore="ContentDescription" />
        </androidx.constraintlayout.widget.ConstraintLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:id="@+id/tv_from_error"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/fab_margin"
        android:alpha="0"
        android:textColor="@color/colorError"
        app:layout_constraintBottom_toTopOf="@+id/fab_swap"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

      <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_swap"
        style="@style/FloatingActionButton.Small"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fab_margin"
        app:layout_constraintBottom_toTopOf="@+id/tv_to_label"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@drawable/ic_swap"
        tools:ignore="ContentDescription" />

      <TextView
        android:id="@+id/tv_to_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/fab_margin"
        android:text="@string/label_to_long"
        android:textColor="@color/colorOnPrimary"
        android:textSize="@dimen/text_size_20"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/cv_to_input"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9" />

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_to_input"
        style="@style/CardView.Regular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/fab_margin"
        app:layout_constraintBottom_toTopOf="@+id/tv_to_error"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.9">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:id="@+id/cl_to_input"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:animateLayoutChanges="true"
          android:background="?selectableItemBackground"
          app:rippleColor="@color/colorOnPrimaryLight">

          <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/il_to"
            style="@style/Widget.Design.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_7"
            android:layout_marginTop="@dimen/margin_2"
            android:layout_marginEnd="@dimen/margin_7"
            android:layout_marginBottom="@dimen/margin_7"
            android:hint="@string/hint_to"
            android:theme="@style/Input.Regular"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_to_clear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <com.google.android.material.textfield.TextInputEditText
              android:id="@+id/et_to"
              android:layout_width="match_parent"
              android:layout_height="@dimen/search_input_height"
              android:background="@android:color/transparent"
              android:ellipsize="end"
              android:focusableInTouchMode="false"
              android:imeOptions="actionSearch"
              android:inputType="text"
              android:paddingTop="@dimen/margin_x_small"
              android:textColor="@color/colorOnPrimary"
              android:textColorHint="@color/colorHint"
              android:textSize="@dimen/input_text_size" />
          </com.google.android.material.textfield.TextInputLayout>

          <ImageButton
            android:id="@+id/btn_to_map"
            android:layout_width="@dimen/icon_size2"
            android:layout_height="@dimen/icon_size2"
            android:layout_marginStart="@dimen/margin_small"
            android:layout_marginEnd="@dimen/margin_small"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_map"
            tools:ignore="ContentDescription" />

          <ImageButton
            android:id="@+id/btn_to_list"
            android:layout_width="@dimen/icon_size2"
            android:layout_height="@dimen/icon_size2"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="center"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_to_map"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_arrow_drop_down"
            tools:ignore="ContentDescription" />

          <ImageButton
            android:id="@+id/btn_to_clear"
            android:layout_width="@dimen/icon_size2"
            android:layout_height="@dimen/icon_size2"
            android:background="?selectableItemBackgroundBorderless"
            android:scaleType="centerInside"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_to_list"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/ic_close_black_24dp"
            tools:ignore="ContentDescription" />
        </androidx.constraintlayout.widget.ConstraintLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView
        android:id="@+id/tv_to_error"
        android:layout_width="382dp"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/fab_margin"
        android:alpha="0"
        android:textColor="@color/colorError"
        app:layout_constraintBottom_toTopOf="@+id/btn_search"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_search"
        style="@style/Button.Search"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/button_size"
        android:text="@string/label_search"
        app:icon="@drawable/ic_search_colored"
        app:layout_constraintBottom_toTopOf="@+id/btn_transports"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

      <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_transports"
        style="@style/Button.Transports"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_all_transports"
        app:icon="@drawable/ic_arrow_up"
        app:iconGravity="textTop"
        app:layout_constraintBottom_toTopOf="@+id/cv_rate"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent" />

      <com.google.android.material.card.MaterialCardView
        android:id="@+id/cv_rate"
        style="@style/CardView.Regular"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/fab_margin"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        tools:visibility="visible">

        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content">

          <TextView
            android:id="@+id/tv_rate_message"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/fab_margin"
            android:text="@string/message_rate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_rate"
            style="@style/Button.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_x_small"
            android:text="@string/label_rate"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

          <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dismiss"
            style="@style/Button.Regular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/margin_x_small"
            android:text="@string/label_dismiss"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_rate"
            app:layout_constraintTop_toBottomOf="@id/tv_rate_message" />
        </androidx.constraintlayout.widget.ConstraintLayout>
      </com.google.android.material.card.MaterialCardView>
    </androidx.constraintlayout.widget.ConstraintLayout>
  </androidx.core.widget.NestedScrollView>

  <com.google.android.material.appbar.AppBarLayout
    android:id="@+id/app_bar"
    style="@style/Background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:theme="@style/AppTheme.AppBarOverlay"
    app:elevation="0dp">

    <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?actionBarSize"
      app:popupTheme="@style/AppTheme.PopupOverlay">

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
          android:id="@+id/iv_logo"
          android:layout_width="36dp"
          android:layout_height="36dp"
          android:layout_gravity="center"
          android:background="?selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"
          android:src="@drawable/ic_logo"
          tools:ignore="ContentDescription" />

        <TextView
          android:id="@+id/tv_title"
          style="@style/Text.Toolbar"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_gravity="center"
          android:text="@string/app_name" />
      </LinearLayout>
    </androidx.appcompat.widget.Toolbar>
  </com.google.android.material.appbar.AppBarLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
